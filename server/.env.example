# Copy this file to `server/.env` and fill in a TMDB credential.
# `server/.env` is gitignored, so your key stays out of the repository.

# --- TMDB credentials (provide EITHER one; the Bearer token is preferred) -----
# Get them free at https://www.themoviedb.org/settings/api
#
# v4 read access token (long JWT-looking string) -> sent as `Authorization: Bearer`
TMDB_ACCESS_TOKEN=
# v3 API key (32-char hex) -> sent as `?api_key=`
TMDB_API_KEY=
#
# Both are supported because TMDB issues both and you may only have one.
# With neither set the server still boots: movie routes return a labelled
# 503 UPSTREAM_MISCONFIGURED, genres fall back to a hardcoded list, and the
# wishlist keeps working from the local snapshot table. An empty grid looks
# like a bug, so the app says exactly what is wrong instead.

# --- server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated allowed origins for CORS. The Expo web dev server is :8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- database ----------------------------------------------------------------
# Relative to the server/ directory. The folder is created at boot.
DATABASE_PATH=./data/movies.db

# --- demo / debugging --------------------------------------------------------
# Set to 1 to expose POST /api/debug/* (fault injection, cache clear, breaker
# control) for curl-driven demos — see the README's resilience section. These
# endpoints 404 when this is unset, so leave it off outside local development.
# There is no in-app screen for this: backend health is a reviewer concern,
# not an end-user one.
ENABLE_FAULT_INJECTION=1

# Log level: debug | info | warn | error
LOG_LEVEL=info
