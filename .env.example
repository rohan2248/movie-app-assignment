# Copy to `.env` (which is gitignored) if you need to override the API base URL.
#
# You usually do NOT need this file. When it is unset, the app derives the API
# host from the Expo dev server (Constants.expoConfig.hostUri), which is what
# makes a physical device on Expo Go work with no configuration at all.
#
# Set it explicitly when the API runs somewhere else (a deployed server, a
# different port, or a tunnel).
#
# Must be read as a literal `process.env.EXPO_PUBLIC_API_URL` — Metro only
# inlines direct dot-access, so destructuring or bracket access yields undefined.
#
# EXPO_PUBLIC_API_URL=http://localhost:4000

# The TMDB key is deliberately NOT here. It lives only in server/.env so it is
# never bundled into the client. Never put a secret behind an EXPO_PUBLIC_ name.
